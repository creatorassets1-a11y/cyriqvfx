{
  "name": "apexedit",
  "version": "0.1.0",
  "private": true,
  "description": "ApexEdit — professional, offline-first mobile video editor",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @apex/edit-engine",
