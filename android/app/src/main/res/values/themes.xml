<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        A plain dark theme: Compose owns all styling, so this exists only to set
        the window background before the first frame draws. Matching it to the
        editor's base colour prevents a white flash on cold start.
    -->
    <style name="Theme.ApexEdit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/apex_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
