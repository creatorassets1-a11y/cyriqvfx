# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/cyriqvfx?schema=public"

# 32+ characters. Derives session and token hashes. Rotating it signs everyone
# out and invalidates outstanding verification and reset links.
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Canonical public origins. Used for canonical URLs, OG tags and email links.
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Browser origins allowed to call the API with credentials, comma separated.
CORS_ORIGINS=http://localhost:5173

# Set true when running behind a reverse proxy so client IPs are read correctly.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Storage. R2 is required in production; the app refuses to boot without it.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Optional CDN base for public media (thumbnails, previews).
# R2_PUBLIC_BASE_URL=https://media.example.com

# How long a download grant stays valid. Short by design, because it is a bearer token.
DOWNLOAD_URL_TTL_SECONDS=300
MEDIA_URL_TTL_SECONDS=3600

# 5 GiB default ceiling; per-asset-type limits are enforced in code as well.
MAX_UPLOAD_BYTES=5368709120
# Files at or above this size use resumable multipart upload.
MULTIPART_THRESHOLD_BYTES=67108864

# ---------------------------------------------------------------------------
# Cookies. COOKIE_SECURE must be true in production.
# ---------------------------------------------------------------------------
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Owner account, created by the seed if it does not exist.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=owner@example.com
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-this-before-seeding

# ---------------------------------------------------------------------------
# Email. The console driver logs links instead of sending, which is enough to
# use verification and password reset locally without a provider.
# ---------------------------------------------------------------------------
EMAIL_DRIVER=console
# RESEND_API_KEY=
EMAIL_FROM="Cyriq VFX <noreply@example.com>"

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
LOG_LEVEL=info
JOBS_ENABLED=true
RATE_LIMIT_DISABLED=false
